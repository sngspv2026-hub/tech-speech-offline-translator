<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Enforces TLS/HTTPS (cleartextTrafficPermitted="false") with standard system CA certificates
      for Google ML Kit On-Device model downloads and HTTPS NMT fallback endpoints.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
